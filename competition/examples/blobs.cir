Men1 n_error1 n_neg1 0 0 nch W=20u L=1u
Moff1 n_error1 voffset vdd vdd pch W=10u L=1u
Mtarget1 n_error1 target1 0 0 nch W=10u L=1u
Rscore1 out1 vref 7k
Rerror1 n_error1 verror 7k
