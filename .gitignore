# Repository policy and regeneration notes: docs/REPOSITORY_HYGIENE.md

# Python / local development state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.claude/
.codex/
.DS_Store
*.lock

# Build products
build/
dist/
*.egg-info/
*.o
*.a
*.so
*.so.*
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.xdv
/paper/paper.pdf
/position.pdf

# Simulator output (including Spectre's extension variants)
*.raw
*.log
*.dat
*.prn
*.time
*.out
*.srf
*.ns@*
*.psf
*.curve
raw_*/
rawcn_*/
*.best

# Downloaded datasets, caches and generated arrays.
# Small calibration fixtures used by source code are explicitly retained.
/data/
*.tar.gz
*.npy
*.npz
!/experiments/fixtures/cal.npy
!/fastsim/char.npz
!/fastsim/cmld_tables.npz
!/fastsim/devnet_tables.npz
!/fastsim/gprod_char.npy
!/fastsim/gprod_grid.npz
!/fastsim/gprod_gridCM.npz
!/fastsim/trace_ref.npz

# Reference decks live in circuits/; root decks are generated experiment output.
# Circuit sources in fastsim/ and competition/examples/ also remain versioned.
/*.cir
/*.scs

# Frozen figures/results live under docs/; new runs write ignored root outputs.
/*.png
/*.json
/*.txt
!/requirements.txt
/rec2_vg
/results/

# Local copies of former root entry points; canonical sources are in experiments/.
/gen_mc.py
/gen_mc_infer.py
/score_mc.py
/spectre_mc.py
